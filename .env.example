# Autonomous Rocket Landing — Environment Configuration
# Copy this file to .env and adjust variables as required for deployment.

# Server Network Configuration
HOST=0.0.0.0
PORT=8080

# Concurrency & Resource Limits
# Maximum concurrent WebSocket simulation sessions permitted simultaneously
MAX_CONCURRENT_SESSIONS=20

# Active PPO Model Checkpoint
MODEL_CHECKPOINT_PATH=models/benchmark/D_curriculum_and_dr/seed_42/final_model.zip

# CORS Settings (comma-separated origins or * for all)
CORS_ORIGINS=*

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
